{
  "name": "womenofopensource-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Lint tooling and CI configuration for the Women of Open Source website (the site itself lives in docs/).",
  "scripts": {
    "lint:js": "eslint docs/js/personal.js",
    "lint:css": "stylelint \"docs/_sass/**/*.scss\"",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.48.0",
    "eslint": "^10.9.1",
    "http-server": "^14.1.1",
    "markdownlint-cli2": "^0.23.2",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  }
}
